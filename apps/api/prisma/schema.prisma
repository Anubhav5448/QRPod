// ─────────────────────────────────────────────
// Prisma Schema — SuperAdmin (Phase 1)
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum PlatformRole {
  SUPERADMIN
  USER
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(120)
  email         String       @unique @db.VarChar(255)
  phone         String?      @unique @db.VarChar(20)
  passwordHash  String       @map("password_hash") @db.Text
  isActive      Boolean      @default(true) @map("is_active")
  platformRole  PlatformRole @default(USER) @map("platform_role")

  auditLogs     SuperAdminAuditLog[]
  memberships   RestaurantMember[]
  passwordResetTokens PasswordResetToken[]

  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model SuperAdminAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  superadminId  String   @map("superadmin_id") @db.Uuid
  superadmin    User     @relation(fields: [superadminId], references: [id], onDelete: Cascade)

  restaurantId  String?  @map("restaurant_id") @db.Uuid
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  action        String   @db.VarChar(100)
  targetType    String   @map("target_type") @db.VarChar(50)
  targetId      String?  @map("target_id") @db.Uuid
  metadata      Json?

  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([restaurantId])
  @@index([superadminId, createdAt])
  @@index([action, createdAt])
  @@map("superadmin_audit_logs")
}

// ─────────────────────────────────────────────
// Restaurant / Tenancy
// ─────────────────────────────────────────────

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Restaurant {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @db.VarChar(150)
  slug                 String             @unique @db.VarChar(180)
  logoUrl              String?            @map("logo_url") @db.Text
  coverUrl             String?            @map("cover_url") @db.Text
  phone                String?            @db.VarChar(20)
  address              String?            @db.Text
  currency             String             @default("INR") @db.Char(3)

  taxEnabled           Boolean            @default(false) @map("tax_enabled")
  taxRate              Decimal?           @map("tax_rate") @db.Decimal(5, 2)
  serviceChargeEnabled Boolean            @default(false) @map("service_charge_enabled")
  serviceChargeRate    Decimal?           @map("service_charge_rate") @db.Decimal(5, 2)

  status               RestaurantStatus   @default(PENDING)
  suspendedAt          DateTime?          @map("suspended_at") @db.Timestamptz(6)
  suspendedBy          String?            @map("suspended_by") @db.Uuid
  suspensionReason     String?            @map("suspension_reason") @db.Text

  members              RestaurantMember[]
  tables               Table[]
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  auditLogs            SuperAdminAuditLog[]
    orders               Order[]
  

  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([slug])
  @@map("restaurants")
}

enum RestaurantRole {
  OWNER
  MANAGER
  EMPLOYEE
  KITCHEN
}

model RestaurantMember {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String         @map("user_id") @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  role         RestaurantRole
  isActive     Boolean        @default(true) @map("is_active")

  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([restaurantId, userId])
  @@index([userId, isActive])
  @@map("restaurant_members")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String   @map("token_hash") @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)

  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}


enum TableStatus {
  AVAILABLE
  OCCUPIED
  INACTIVE
}

model Table {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableNumber  String      @map("table_number") @db.VarChar(30)
  displayName  String?     @map("display_name") @db.VarChar(80)
  seats        Int?
  qrToken      String      @unique @map("qr_token") @db.VarChar(128)
  status       TableStatus @default(AVAILABLE)


  orders               Order[]

  
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, status])
  @@map("tables")
}

// ─────────────────────────────────────────────
// Menu
// ─────────────────────────────────────────────

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String   @db.VarChar(120)
  description  String?  @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")

  items        MenuItem[]

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([restaurantId, name])
  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id              String        @id @default(uuid()) @db.Uuid
  restaurantId    String        @map("restaurant_id") @db.Uuid
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String        @map("category_id") @db.Uuid
  category        MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name            String        @db.VarChar(150)
  description     String?       @db.Text
  imageUrl        String?       @map("image_url") @db.Text
  price           Decimal       @db.Decimal(12, 2)
  prepTimeMinutes Int?          @map("prep_time_minutes")
  isAvailable     Boolean       @default(true) @map("is_available")
  sortOrder       Int           @default(0) @map("sort_order")

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId, isAvailable, sortOrder])
  @@index([restaurantId])
  @@map("menu_items")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

model Order {
  id                    String           @id @default(uuid()) @db.Uuid
  orderNumber           String           @unique @map("order_number") @db.VarChar(30)

  restaurantId          String           @map("restaurant_id") @db.Uuid
  restaurant            Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  tableId               String           @map("table_id") @db.Uuid
  table                 Table            @relation(fields: [tableId], references: [id], onDelete: Restrict)

  customerName          String?          @map("customer_name") @db.VarChar(120)
  customerPhone         String?          @map("customer_phone") @db.VarChar(20)
  customerNote          String?          @map("customer_note") @db.Text

  status                OrderStatus      @default(PENDING)
  paymentStatus         PaymentStatus    @default(UNPAID) @map("payment_status")

  subtotal              Decimal          @db.Decimal(12, 2)
  taxAmount             Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  serviceChargeAmount   Decimal          @default(0) @map("service_charge_amount") @db.Decimal(12, 2)
  totalAmount           Decimal          @map("total_amount") @db.Decimal(12, 2)

  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]

  placedAt              DateTime         @default(now()) @map("placed_at") @db.Timestamptz(6)
  acceptedAt            DateTime?        @map("accepted_at") @db.Timestamptz(6)
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?        @map("cancelled_at") @db.Timestamptz(6)

  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([restaurantId, status, createdAt])
  @@index([tableId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @map("order_id") @db.Uuid
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId        String      @map("menu_item_id") @db.Uuid
  menuItemNameSnapshot String   @map("menu_item_name_snapshot") @db.VarChar(150)
  unitPrice         Decimal     @map("unit_price") @db.Decimal(12, 2)
  quantity          Int
  lineTotal         Decimal     @map("line_total") @db.Decimal(12, 2)
  itemNote          String?     @map("item_note") @db.Text

  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus @map("to_status")
  changedBy     String?     @map("changed_by") @db.Uuid
  reason        String?     @db.Text

  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}